{
  "rules": {
    "rooms": {
      "$room_id": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",

        "players": {
          "$player_id": {
            ".write": "auth != null && (newData.child('uid').val() === auth.uid || data.parent().parent().child('hostUid').val() === auth.uid)"
          }
        },
        "actions": {
          "$action_id": {
            ".write": "auth != null && !data.exists() && (data.parent().parent().child('hostUid').val() === auth.uid || (root.child('rooms').child($room_id).child('players').child(newData.child('sender').val()).child('uid').val() === auth.uid && (newData.child('action').val() === 'switch_pokemon' || newData.child('action').val() === 'form_change' || newData.child('action').val() === 'trade_pokemon' || newData.child('action').val() === 'attack' || newData.child('action').val() === 'evolve' || newData.child('action').val() === 'devolve')))"
          }
        },
        "entryQueue": {
          "$player_id": {
            ".write": "auth != null && (newData.child('uid').val() === auth.uid || data.parent().parent().child('hostUid').val() === auth.uid)"
          }
        },
        "state": {
          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid"
        },
        "settings": {
          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid"
        }
      }
    },
    "roomAliases": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$room_code": {
        ".validate": "newData.isString() && newData.val().length > 0"
      }
    },
    "errors": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "recent_rooms": {
          "$room_code": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "saved_games": {
          "$game_id": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
